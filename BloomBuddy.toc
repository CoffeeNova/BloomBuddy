# Load order matters: bootstrap first, then Data/Utils, then Classes.
# Every file receives the shared BB table through the `...` vararg chain
# (each module file must end with `return BB;`).

bootstrap.lua

Data/Constants.lua
Data/DefaultSettings.lua
Data/Localization.lua

Utils/Tables.lua
Utils/Timers.lua

Classes/Events.lua
Classes/Settings.lua
Classes/Frames.lua
Classes/OptionsUI.lua